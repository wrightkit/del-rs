// expect: semantic-error
// note: expects error 'Constant or parallel operand type '{Number struct_value}' cannot be used to pattern match with enum type 'EnumTest''
enum EnumTest {
    A
}

rule: "Incompatible pattern matching errors" {
    if ({struct_value: 0} is EnumTest.A) {}
}
