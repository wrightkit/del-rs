// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/Semantics/GenericsTest.cs
// license: MIT
// expect: ok
// note: issue #476
rule: 'My Rule' {
    # init
    Test<Struct> t = new Test<Struct>();
    # log
    t.Log();
}

struct Struct {
    public Number x;
    public Number y;
}

class Test<T> {
    public void LogInner() 'Inner Subroutine' {}

    public void Log() 'Outer Subroutine' {
        LogInner();
    }
}
