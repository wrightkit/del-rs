// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/EnumTest.cs
// license: MIT
// expect: semantic-error
// note: expects error 'The variable 'value' cannot be set'
enum EnumTest {
    A(Number),
    B(String, String)
}

rule: "Variable binding mutability" {
    if (EnumTest.A(0) is EnumTest.A(value)) {
        value = 5;
    }
}
