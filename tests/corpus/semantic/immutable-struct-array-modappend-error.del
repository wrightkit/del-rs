// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/ArrayTest.cs
// license: MIT
// expect: semantic-error
// note: expects error 'Functions that directly modify arrays requires a mutable variable as the source'
struct Struct {
    public Number[] arr;
}

Struct get_struct(): { arr: [] };

rule: "" {
    get_struct().arr.ModAppend(4);
}
