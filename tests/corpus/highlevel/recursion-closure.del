// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/RecursionTest.cs
// license: MIT
// expect: ok
globalvar Number[] => Number[] sub = values => {
    LogToInspector('input: ' + values);

    Any[] arr = [];
    arr[0] = values[0] + 1;
    arr[1] = values[1] + 1;
    arr[2] = values[2] + 1;

    if (arr[0] == 10) return [];

    define got = sub(arr);
    LogToInspector('got: ' + got);
    return arr.Append(got);
};


rule: ''
{
    define result = sub([1, 2, 3]);
    LogToInspector(result);
}
