// expect: ok
rule: "Enum pattern matching" {
    if (EnumTest.B is EnumTest.A) {
        define a = true;
    }

    if (EnumTest.B is EnumTest.B) {
        define b = true;
    }

    if (EnumTest.B is EnumTest.C) {
        define c = true;
    }
}

enum EnumTest {
    A,
    B,
    C
}
