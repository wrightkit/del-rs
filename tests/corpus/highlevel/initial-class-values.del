// license: MIT
// expect: ok
// note: issue #355
class Class {
    public Number num;
    public Str str = { x: 1, y: 2 };
}

struct Str {
    public Number x;
    public Number y;
}

rule: "" {
    Class instance = new Class();
    define a = instance.num;
    define b = instance.str.x;
    define c = instance.str.y;
}
