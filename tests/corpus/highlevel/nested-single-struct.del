// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/StructTest.cs
// license: MIT
// expect: ok
single struct NestedStruct
{
    public String A;
    public String B;
}

struct Struct
{
    public NestedStruct Nested;
    public NestedStruct GetNested() {return Nested;}
}

globalvar Struct myStruct = {
    Nested: {
        A: "a",
        B: "b"
    }
};

rule: 'Read nested struct value'
{
    String b = myStruct.GetNested().B;
}
