// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/HighLevelTest.cs
// license: MIT
// expect: ok
globalvar Number TEST_0;
globalvar Number TEST_1;
globalvar Number TEST_2;
globalvar Number TEST_3;
globalvar Number TEST_4;

void ExecuteSwitch(in Number value, ref Number out)
{
    switch (value)
    {
        case 0:
            out = 1;
            break;

        case 1:
            out = 2;
            // Fallthrough to case 2
        case 2:
            out += 3;
            break;
        
        default:
            out = -1;
            break;
        
        case 3:
            out = -2;
    }
}

rule: "Test switches"
{
    ExecuteSwitch(0, TEST_0);
    ExecuteSwitch(1, TEST_1);
    ExecuteSwitch(2, TEST_2);
    ExecuteSwitch(3, TEST_3);
    ExecuteSwitch(4, TEST_4);
}
