// source: https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/blob/817c1db4bace52123f054ffe10d3d8a06052e687/Deltinteger/Deltinteger.Tests/HighLevelTests/EnumTest.cs
// license: MIT
// expect: ok
rule: "enum test" {
    define b = EnumTest.B(5);
    define c = EnumTest.C("one", "two");

    define take = c[2];
    define take_key = ["a", "b", "c", "d"][c[0]];
}

single enum EnumTest {
    A,
    B(Number),
    C(String, String),
    D
}
