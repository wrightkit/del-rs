// expect: ok
enum EnumTest {
    A(Number),
    B(String, String)
}

globalvar Player p = HostPlayer();
playervar EnumTest value;

rule: ""
{
    p.value = EnumTest.B("one", "two");

    if (p.value is EnumTest.B(first, second)) {
        second = "three";
    }
}
