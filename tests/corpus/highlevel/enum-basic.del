rule: "enum test" {
    define a = EnumTest.A;
    define b = EnumTest.B;
    define c = EnumTest.C;
    define d = EnumTest.D;

    define added = a + b + c + d;

    define used_as_indexer = [5, 6, 7, 8][c];
}

enum EnumTest {
    A,
    B,
    C,
    D
}
